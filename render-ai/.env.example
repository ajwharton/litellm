# Copy to render-ai/.env and fill in before running locally or on forge.
# Direct providers — no OpenRouter.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
MOONSHOT_API_KEY=sk-...          # Kimi — https://platform.moonshot.ai
XAI_API_KEY=xai-...              # Grok — https://console.x.ai

LITELLM_MASTER_KEY=sk-render-local-dev

# Optional overrides
RENDER_CAPABILITY_FAIL_UP=high-reasoning
RENDER_KNOWN_CAPABILITIES=high-reasoning,high-coding,cheap-deterministic,multimodal